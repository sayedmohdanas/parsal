<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
      <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
 <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
   
<!-- <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/> -->
<uses-permission android:name="android.permission.WAKE_LOCK"/>
<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />  
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
<application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    android:theme="@style/AppTheme"
    android:supportsRtl="true"
    android:usesCleartextTraffic="true">

    <!-- 🔐 Required permissions for location + foreground -->
    <meta-data android:name="com.google.android.geo.API_KEY"
        android:value="AIzaSyAbwv5P-iff_vVB7TpstiQ1RI1kvktza48" />

    <!-- 👇 ForegroundService plugin requirement -->
    <service
        android:name="com.supersami.foregroundservice.ForegroundService"
        android:enabled="true"
        android:exported="true" />

    <!-- Optional: Your custom LocationService (not used in the JS you showed) -->
    <service
        android:name=".LocationService"
        android:enabled="true"
        android:exported="true"
        android:foregroundServiceType="location" />

    <!-- 🔁 Background Fetch setup -->
    <receiver
        android:name="com.transistorsoft.rnbackgroundfetch.HeadlessTask"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
            <action android:name="com.transistorsoft.fetch.event.BACKGROUND_FETCH" />
        </intent-filter>
    </receiver>
  <service
  android:name="com.zoontek.rnbackgroundactions.RNBackgroundActionsService"
  android:exported="false"
  android:foregroundServiceType="location|dataSync" />
<service android:name="com.asterinet.react.bgactions.RNBackgroundActionsTask" />

    <receiver
        android:name="com.transistorsoft.rnbackgroundfetch.BootReceiver"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.REBOOT" />
        </intent-filter>
    </receiver>

    <receiver
        android:name="com.transistorsoft.rnbackgroundfetch.BackgroundFetch$Receiver"
        android:enabled="true"
        android:exported="true" />

    <service
        android:name="com.transistorsoft.rnbackgroundfetch.FetchJobService"
        android:permission="android.permission.BIND_JOB_SERVICE"
        android:exported="true" />

    <!-- Notifee background support -->
    <service
        android:name="io.invertase.notifee.HeadlessService"
        android:exported="false" />

    <!-- 👇 Your main activity -->
    <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="portrait"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

</application>

</manifest>






